rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in ["kingsclothingbrand7@gmail.com", "danieldeking10@gmail.com"] ||
        (exists(/databases/$(database)/documents/agents/$(request.auth.uid)) && get(/databases/$(database)/documents/agents/$(request.auth.uid)).data.role == "admin")
      );
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isVerifiedUser() { return isSignedIn(); } // Simplified to prevent email-provider sync check issues during dev/sandbox testing

    // --- Validation Blueprints ---

    function isValidAgent(data) {
      return (data.uid == request.auth.uid || isAdmin())
        && data.email is string && data.email.size() <= 200
        && data.role in ["user", "agent", "admin"]
        && (data.name is string && data.name.size() <= 100)
        && (data.referredBy == null || data.referredBy is string)
        && (data.keys().hasAll(['uid', 'email', 'role', 'createdAt']));
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category.size() <= 100
        && data.basePrice is number && data.basePrice >= 0
        && (data.status == "pending" || isAdmin()) // Only admin can approve
        && (data.agentId == null || data.agentId == request.auth.uid || isAdmin())
        && (data.createdAt == request.time || data.createdAt == existing().createdAt);
    }

    function isValidOrder(data) {
      return data.totalAmount is number && data.totalAmount > 0
        && data.depositAmount is number && data.depositAmount >= 0
        && data.status in ["pending", "processing", "shipped", "delivered", "completed", "cancelled"]
        && (data.customerId == null || (data.customerId is string && (data.customerId == request.auth.uid || data.customerId.startsWith('guest_'))) || isAdmin())
        && (data.items is list && data.items.size() > 0);
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 1000
        && data.createdAt == request.time;
    }

    function isValidPayout(data) {
      return data.agentId == request.auth.uid
        && data.amount is number && data.amount > 0
        && data.status == "Requested"
        && data.momoNumber is string && data.momoNumber.size() > 0
        && data.momoProvider in ["mtn", "telecel", "airteltigo"]
        && data.createdAt == request.time;
    }

    function isValidPromotion(data) {
      return data.name is string && data.name.size() > 0
        && data.active is bool
        && data.discountPercentage is number && data.discountPercentage >= 0 && data.discountPercentage <= 100
        && (data.createdAt == request.time || data.createdAt == existing().createdAt);
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() > 0
        && data.discountPercentage is number && data.discountPercentage >= 0 && data.discountPercentage <= 100
        && data.active is bool
        && data.usageCount is number
        && (data.createdAt == request.time || data.createdAt == existing().createdAt);
    }

    function isValidNotification(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.message is string && data.message.size() <= 1000
        && data.type in ["promotion", "coupon", "general", "order"]
        && (data.discountPercentage == null || data.discountPercentage is number)
        && (data.code == null || data.code is string)
        && (data.userId == null || data.userId is string)
        && (data.orderId == null || data.orderId is string)
        && (data.status == null || data.status is string)
        && (data.createdAt == request.time || data.createdAt == existing().createdAt);
    }

    // --- Collections ---

    match /agents/{agentId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || resource.data.referredBy == request.auth.uid;
      allow create: if isSignedIn() && isValidId(agentId) && isValidAgent(incoming()) && incoming().createdAt == request.time && incoming().role != "admin";
      allow update: if (isOwner(agentId) || isAdmin())
        && isValidAgent(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'stats'])) ||
          (isOwner(agentId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'stats', 'referralCode', 'momoNumber', 'momoProvider', 'updatedAt']))
        );
    }

    match /products/{productId} {
      allow get: if true;
      allow list: if resource.data.status == "approved" || resource.data.agentId == request.auth.uid || isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isVerifiedUser() && isValidId(reviewId) && isValidReview(incoming());
        allow delete: if isAdmin() || isOwner(existing().userId);
      }
      allow create: if isVerifiedUser() && isValidId(productId) && isValidProduct(incoming()) && incoming().createdAt == request.time;
      allow update: if (
          (incoming().diff(existing()).affectedKeys().hasOnly(['salesCount']) && incoming().salesCount is number) || // Enabled for guest/all checkout increments
          (isVerifiedUser() && (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'mockupImage', 'studioImage', 'blueprintImage', 'isPrivate', 
              'updatedAt', 'allowedColors', 'colorStudioImages', 'colorBlueprints', 
              'colorImages', 'name', 'description', 'basePrice', 'gsmPrices', 'gsmOptions', 'salesCount', 'aiTags'
            ])) ||
            (isOwner(existing().agentId) && existing().status == "pending" && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'basePrice', 'allowedColors']))
          ) && isValidProduct(incoming()))
        );
      allow delete: if isAdmin() || isOwner(existing().agentId);
    }

    match /orders/{orderId} {
      allow get: if true; // Securely allow direct tracking lookup via cryptographic Order ID
      allow list: if (resource.data.customerId == null || resource.data.customerId == request.auth.uid || resource.data.customerId.startsWith('guest_') || isAdmin());
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && incoming().createdAt == request.time;
      allow update: if (isOwner(existing().customerId) || (existing().customerId != null && existing().customerId.startsWith('guest_')) || isAdmin())
        && isValidOrder(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasAll(['status']) || isAdmin()) ||
          ((isOwner(existing().customerId) || existing().customerId.startsWith('guest_')) && existing().status == "pending" && incoming().diff(existing()).affectedKeys().hasAny([
            'status', 'paymentMethod', 'paymentSubmitted', 'paymentSubmittedAt', 
            'paystackReference', 'paymentResult', 'paymentConfirmedAt',
            'isCancelled', 'cancelledAt', 'cancellationReason', 'updatedAt'
          ]))
        );
    }

    match /payouts/{payoutId} {
      allow read: if isOwner(resource.data.agentId) || isAdmin();
      allow create: if (isSignedIn() && isValidPayout(incoming())) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Explicitly allow error system logs
    match /system_logs/{logId} {
      allow create: if true; // Allow logging even if unsigned or for anonymous reports
      allow read, update, delete: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidPromotion(incoming());
    }

    match /coupons/{couponId} {
      allow read: if true; // Public for validation
      allow create, delete: if isAdmin() && isValidCoupon(incoming());
      allow update: if (isAdmin() && isValidCoupon(incoming())) || (
        isValidCoupon(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) &&
        incoming().usageCount is number
      );
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if (isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid) || incoming().type == "order") && isValidNotification(incoming());
    }

    match /test/{docId} {
      allow get: if true;
    }
  }
}
