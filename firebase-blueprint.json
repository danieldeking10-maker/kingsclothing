{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "A user profile representing a brand agent or customer.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "agent", "admin"] },
        "referredBy": { "type": ["string", "null"] },
        "momoNumber": { "type": "string" },
        "referralCode": { "type": "string" },
        "stats": {
          "type": "object",
          "properties": {
            "totalSales": { "type": "number" },
            "commissionEarned": { "type": "number" },
            "designsApproved": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "An apparel item in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "basePrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "archived"] },
        "agentId": { "type": ["string", "null"] },
        "salesCount": { "type": "number" },
        "outOfStock": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "A customer purchase record.",
      "type": "object",
      "properties": {
        "customerId": { "type": ["string", "null"] },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "totalAmount": { "type": "number" },
        "depositAmount": { "type": "number" },
        "status": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paystackReference": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoProvider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Promotion": {
      "title": "Promotion",
      "description": "An active site-wide discount or campaign.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "active": { "type": "boolean" },
        "discountPercentage": { "type": "number" },
        "message": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "active", "discountPercentage", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "A reusable or single-use discount code.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "usageLimit": { "type": ["number", "null"] },
        "usageCount": { "type": "number" },
        "expiryDate": { "type": ["string", "null"], "format": "date-time" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "discountPercentage", "usageCount", "active", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "App alerts regarding promotions, coupons, and order status changes.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["promotion", "coupon", "general", "order"] },
        "discountPercentage": { "type": ["number", "null"] },
        "code": { "type": ["string", "null"] },
        "userId": { "type": ["string", "null"] },
        "orderId": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "type", "createdAt"]
    },
    "RestockSubscription": {
      "title": "RestockSubscription",
      "description": "User subscription for out-of-stock item restocking.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "notified": { "type": "boolean" }
      },
      "required": ["productId", "productName", "email", "createdAt", "notified"]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": "Agent",
      "description": "User profiles and agent data."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product catalog."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "/promotions/{promoId}": {
      "schema": "Promotion",
      "description": "Active site-wide promotions."
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Available discount coupons."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Broadcast notifications sent to customers."
    },
    "/restock_subscriptions/{subscriptionId}": {
      "schema": "RestockSubscription",
      "description": "Subscriptions for when custom designs are restocked."
    },
    "/system_logs/{logId}": {
      "schema": { "type": "object", "properties": {} },
      "description": "Application error and event logs."
    }
  }
}
